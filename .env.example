# Copia este archivo a .env para desarrollo local.
# En Netlify: Site configuration → Environment variables (Production + Deploy previews).

# --- Publicas (se inyectan en el cliente; necesarias en el BUILD) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RESTAURANTE_NOMBRE="Isanami Sushi"

# --- Solo servidor (nunca NEXT_PUBLIC_) ---
# Settings → API → service_role. Marcarla como Secret en Netlify.
SUPABASE_SERVICE_ROLE_KEY=
